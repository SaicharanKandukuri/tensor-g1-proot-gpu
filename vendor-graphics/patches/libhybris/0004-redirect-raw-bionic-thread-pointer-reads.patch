     destroy_hybris_tls_state(state);
     abort();
@@ -232,6 +245,7 @@ void linker_prepare_embedded_static_tls() {
   StaticTlsLayout& layout = __libc_shared_globals()->static_tls_layout;
   layout.reserve_exe_segment_and_tcb(nullptr, "libhybris");
   __linker_reserve_bionic_tls_in_static_tls();
+  hybris_tls_set_bionic_thread_pointer_offset(layout.offset_thread_pointer());
 }
 
 void linker_finalize_static_tls() {
